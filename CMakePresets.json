{
  "version": 6,
  "configurePresets": [
    {
      "name": "coverage-gcc",
      "displayName": "Linux GCC coverage",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CODIUM_BLOCKS_ENABLE_CODEBLOCKS_ADAPTER": "OFF",
        "CODIUM_BLOCKS_STRICT_WARNINGS": "ON",
        "CODIUM_BLOCKS_ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "coverage-gcc",
      "configurePreset": "coverage-gcc",
      "jobs": 2
    }
  ]
}
